---
interface Props {
  href: string;
  label: string;
  top: string;
  platform: string;
  mark: "apple" | "play";
}
const { href, label, top, platform, mark } = Astro.props;
---

<a
  class:list={["store-btn", { "store-btn--play": mark === "play" }]}
  href={href}
  rel="noopener noreferrer"
  target="_blank"
  aria-label={label}
>
  {
    mark === "apple" ? (
      <svg class="store-btn__mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M16.37 12.29c.03 3.14 2.76 4.19 2.79 4.2-.02.07-.44 1.5-1.44 2.97-.87 1.27-1.77 2.53-3.19 2.56-1.4.03-1.85-.83-3.45-.83-1.6 0-2.1.8-3.42.86-1.37.05-2.42-1.37-3.3-2.63C2.5 16.5 1.2 12.1 3.1 9.1c.94-1.54 2.63-2.52 4.46-2.55 1.39-.03 2.71.94 3.45.94.74 0 2.26-1.16 3.81-.99.65.03 2.48.26 3.65 1.98-.09.06-2.18 1.27-2.1 3.81zM13.9 5.1c.72-.88 1.21-2.1 1.08-3.32-1.04.04-2.3.7-3.05 1.57-.67.77-1.26 2.01-1.1 3.19 1.17.09 2.36-.59 3.07-1.44z"
        />
      </svg>
    ) : (
      <svg class="store-btn__mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M3 20.5V3.5c0-.59.34-1.11.84-1.35L13.69 12 3.84 21.85C3.34 21.6 3 21.09 3 20.5m13.81-5.38L6.05 21.34l8.49-8.49 2.27 2.27m3.35-4.31c.34.27.59.69.59 1.19s-.25.92-.6 1.19l-2.29 1.32-2.5-2.5 2.5-2.5 2.3 1.3M6.05 2.66l10.76 6.22-2.27 2.27L6.05 2.66z"
        />
      </svg>
    )
  }
  <span class="store-btn__text">
    <span class="store-btn__top">{top}</span>
    <span class="store-btn__platform">{platform}</span>
  </span>
</a>
