---
import Base, { type Lang } from "../layouts/Base.astro";
import Board from "./Board.astro";
import LangSwitch from "./LangSwitch.astro";
import Voxel from "./Voxel.astro";
import Wordmark from "./Wordmark.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const root = import.meta.env.BASE_URL.replace(/\/$/, "");
const alternates = { id: "", en: "en/" };

// Names, player counts and taglines are the app's menu card text (MenuGame in
// ios/Krida/ContentView.swift, *_card_* in Android's strings.xml); keep them identical.
// Colors are the app's card accents.
const colors = ["#8a5a2e", "#4f8a3b", "#3d6eb5", "#1b4f72", "#7b2d3b", "#1a2332"];

const appStoreUrl = "https://apps.apple.com/app/id6832093929";
// Android closed testing via TesBareng (Bilah Aksara store-btn pattern). On public Play:
// swap to Coba Lagi–style official GET IT ON badge + PLAY_STORE_URL.
const tesBarengUrl =
  "https://tesbareng.vercel.app/apps/b2bfd6e9-f394-46b9-adb8-277ba9583ca6";
const playClosedTestingUrl =
  "https://play.google.com/apps/testing/com.ardeman.krida";

const copy = {
  id: {
    title: "Krida — Board games Nusantara, main bareng di mana saja",
    description:
      "Congklak, ular tangga, ludo, perang kapal, gaple dan werewolf. Lawan komputer, main offline lewat Bluetooth atau Wi‑Fi, atau online. Android dan iPhone bisa main bareng.",
    gamesNav: "Permainan",
    whyNav: "Kenapa",
    h1: "Main bareng, di mana saja.",
    lead: "Congklak, ular tangga, ludo, perang kapal, gaple dan werewolf, dibuat ulang jadi mainan kecil yang bisa kamu mainkan bersama keluarga dan teman.",
    downloadAppStore: "Unduh di App Store",
    downloadAppStoreBadge: "id-id",
    downloadAndroid: "Closed testing di Google Play lewat TesBareng",
    downloadAndroidTop: "CLOSED TESTING",
    downloadAndroidPlatform: "Google Play",
    availIos: "iPhone & iPad — App Store",
    availAndroid: "Android — closed testing",
    gamesLead: "Enam permainan: papan voxel dan werewolf sosial.",
    modesTitle: "Cara main",
    modesLead: "Satu meja, banyak cara duduk bersama.",
    modes: [
      { title: "Lawan komputer", body: "Main sendiri, atau isi kursi kosong dengan komputer." },
      { title: "Gantian satu HP", body: "Berdua atau lebih bergiliran di perangkat yang sama." },
      { title: "Nearby", body: "Bluetooth atau Wi‑Fi yang sama, tanpa internet." },
      { title: "Online", body: "Kode room, QR, lobi publik, atau quick match." },
    ],
    games: [
      { name: "Congklak", players: "2 pemain", tagline: "Kumpulkan biji terbanyak di lumbungmu." },
      { name: "Ular tangga", players: "2–4 pemain", tagline: "Naiki tangga, hindari ular." },
      { name: "Ludo", players: "2–4 pemain", tagline: "Pacu empat bidakmu ke rumah." },
      { name: "Perang kapal", players: "2 pemain", tagline: "Tenggelamkan armadanya." },
      { name: "Gaple", players: "2–4 pemain", tagline: "Sambung ujungnya, habiskan kartumu." },
      { name: "Werewolf", players: "5–8 pemain", tagline: "Temukan serigala sebelum mereka menguasai desa." },
    ],
    whyTitle: "Kenapa Krida",
    whyLead: "Dirancang agar keluarga dan teman bisa duduk satu meja, apa pun HP-nya.",
    features: [
      { title: "Main offline", body: "Lewat Bluetooth atau Wi‑Fi yang sama, tanpa internet. Cocok di rumah, di mobil, atau di warung." },
      { title: "Android ↔ iPhone", body: "Semua bisa satu meja, apa pun HP-nya, di setiap mode. Sampai 8 pemain di Werewolf (Wi‑Fi / online)." },
      { title: "Online juga bisa", body: "Bagikan kode room atau QR ke teman yang jauh, atau gabung room publik dan cari pemain lain." },
      { title: "Lawan komputer", body: "Main sendiri lawan komputer, atau gantian berdua di satu HP. Kursi kosong bisa diisi komputer." },
      { title: "Teman", body: "Akun opsional lewat Apple atau Google: tambah teman dengan kodenya dan undang mereka ke room." },
      { title: "Ringan", body: "Aplikasi native, ukuran kecil, lancar di tablet kelas menengah." },
    ],
    lemaDef: "Alasan untuk duduk satu meja, menjadi lawan selama satu ronde, lalu tertawa bersama sesudahnya.",
    lemaSrc: "Dari Sanskerta",
    lemaSrcGloss: "bermain",
    privacy: "Kebijakan privasi",
    privacyPath: "privasi/",
    changelog: "Catatan perubahan",
    changelogPath: "catatan/",
    portfolio: "Ardeman",
  },
  en: {
    title: "Krida — Board games from Indonesia, play together anywhere",
    description:
      "Congklak, snakes & ladders, ludo, battleship, gaple and werewolf. Play the computer, offline over Bluetooth or Wi‑Fi, or online; Android and iPhone play together.",
    gamesNav: "Games",
    whyNav: "Why",
    h1: "Play together, anywhere.",
    lead: "Congklak, snakes & ladders, ludo, battleship, gaple and werewolf, remade as little toys you can play with family and friends.",
    downloadAppStore: "Download on the App Store",
    downloadAppStoreBadge: "en-us",
    downloadAndroid: "Closed testing on Google Play via TesBareng",
    downloadAndroidTop: "CLOSED TESTING",
    downloadAndroidPlatform: "Google Play",
    availIos: "iPhone & iPad — App Store",
    availAndroid: "Android — closed testing",
    gamesLead: "Six games: voxel boards and social werewolf.",
    modesTitle: "How to play",
    modesLead: "One table, several ways to sit together.",
    modes: [
      { title: "Against the computer", body: "Play solo, or fill empty seats with the computer." },
      { title: "Pass and play", body: "Take turns on the same phone or tablet." },
      { title: "Nearby", body: "Bluetooth or the same Wi‑Fi, no internet needed." },
      { title: "Online", body: "Room code, QR, public lobbies, or quick match." },
    ],
    games: [
      { name: "Congklak", players: "2 players", tagline: "Gather the most seeds in your store." },
      { name: "Snakes & ladders", players: "2–4 players", tagline: "Climb the ladders, dodge the snakes." },
      { name: "Ludo", players: "2–4 players", tagline: "Race your four tokens home." },
      { name: "Battleship", players: "2 players", tagline: "Sink the fleet." },
      { name: "Gaple", players: "2–4 players", tagline: "Match the ends, empty your hand." },
      { name: "Werewolf", players: "5–8 players", tagline: "Find the wolves before they outnumber the village." },
    ],
    whyTitle: "Why Krida",
    whyLead: "Built so family and friends can share one table, whatever phone they bring.",
    features: [
      { title: "Play offline", body: "Over Bluetooth or the same Wi‑Fi, no internet needed. At home, in the car, or at a roadside café." },
      { title: "Android ↔ iPhone", body: "Everyone at one table, whatever their phone, in every mode. Up to 8 players in Werewolf (Wi‑Fi / online)." },
      { title: "Online too", body: "Share a room code or QR with a friend far away, or join a public room and find other players." },
      { title: "Against the computer", body: "Play solo against the computer, or take turns on one phone. Empty seats can go to the computer." },
      { title: "Friends", body: "An optional account with Apple or Google: add friends by their code and invite them to your room." },
      { title: "Lightweight", body: "A native app, small download, smooth on a mid-range tablet." },
    ],
    lemaDef: "A reason to sit at one table, be rivals for a round, and laugh together afterwards.",
    lemaSrc: "Indonesian, from Sanskrit",
    lemaSrcGloss: "play",
    privacy: "Privacy policy",
    privacyPath: "en/privacy/",
    changelog: "Changelog",
    changelogPath: "en/changelog/",
    portfolio: "Ardeman",
  },
}[lang];

const portfolioUrl = "https://ardeman.com";

const games = copy.games.map((g, i) => ({ ...g, color: colors[i] }));
const year = new Date().getFullYear();
---

<Base title={copy.title} description={copy.description} lang={lang} alternates={alternates}>
  <main>
    <header class="nav">
      <a class="logo" href={`${root}/${alternates[lang]}`}><Wordmark height={30} /></a>
      <nav class="nav-links" aria-label="Krida">
        <a class="pill" href="#games">{copy.gamesNav}</a>
        <a class="pill" href="#modes">{copy.modesTitle}</a>
        <a class="pill" href="#why">{copy.whyNav}</a>
        <LangSwitch lang={lang} alternates={alternates} />
      </nav>
    </header>

    <section class="hero">
      <div class="hero-text">
        <h1>{copy.h1}</h1>
        <p class="lead">{copy.lead}</p>
        <p class="hero-cta">
          <a
            class="store-badge"
            href={appStoreUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            <picture>
              <source
                srcset={`${root}/badges/app-store-white-${copy.downloadAppStoreBadge}.svg`}
                media="(prefers-color-scheme: dark)"
              />
              <img
                src={`${root}/badges/app-store-black-${copy.downloadAppStoreBadge}.svg`}
                alt={copy.downloadAppStore}
                height="40"
                width="120"
              />
            </picture>
          </a>
          <a
            class="store-btn"
            href={tesBarengUrl}
            rel="noopener noreferrer"
            target="_blank"
            aria-label={copy.downloadAndroid}
          >
            <svg class="store-btn__mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M3 20.5V3.5c0-.59.34-1.11.84-1.35L13.69 12 3.84 21.85C3.34 21.6 3 21.09 3 20.5m13.81-5.38L6.05 21.34l8.49-8.49 2.27 2.27m3.35-4.31c.34.27.59.69.59 1.19s-.25.92-.6 1.19l-2.29 1.32-2.5-2.5 2.5-2.5 2.3 1.3M6.05 2.66l10.76 6.22-2.27 2.27L6.05 2.66z"
              />
            </svg>
            <span class="store-btn__text">
              <span class="store-btn__top">{copy.downloadAndroidTop}</span>
              <span class="store-btn__platform">{copy.downloadAndroidPlatform}</span>
            </span>
          </a>
        </p>
        <ul class="avail">
          <li><span class="avail-dot avail-dot-live" aria-hidden="true"></span>{copy.availIos}</li>
          <li>
            <span class="avail-dot avail-dot-test" aria-hidden="true"></span>
            <a href={playClosedTestingUrl} rel="noopener noreferrer" target="_blank">{copy.availAndroid}</a>
          </li>
        </ul>
      </div>
      <div class="hero-art"><Board /></div>
    </section>

    <section id="games" class="section">
      <div class="section-head">
        <h2>{copy.gamesNav}</h2>
        <p class="section-lead">{copy.gamesLead}</p>
      </div>
      <div class="games">
        {
          games.map((g) => (
            <article class="game" style={`--game-accent: ${g.color}`}>
              <Voxel color={g.color} size={48} />
              <h3 lang={g.name === "Snakes & ladders" ? undefined : "id"}>{g.name}</h3>
              <p class="players">{g.players}</p>
              <p>{g.tagline}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="modes" class="section">
      <div class="section-head">
        <h2>{copy.modesTitle}</h2>
        <p class="section-lead">{copy.modesLead}</p>
      </div>
      <div class="modes">
        {
          copy.modes.map((m, i) => (
            <article class="mode">
              <span class="mode-num" aria-hidden="true">{i + 1}</span>
              <h3>{m.title}</h3>
              <p>{m.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="why" class="section">
      <div class="section-head">
        <h2>{copy.whyTitle}</h2>
        <p class="section-lead">{copy.whyLead}</p>
      </div>
      <div class="features">
        {
          copy.features.map((f) => (
            <article class="feature">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <footer class="footer">
      <p class="lema">
        <span class="lema-head"><b lang="id">krida</b> <span class="lema-say">/kri·da/</span> <i>n.</i></span>
        <span class="lema-def">{copy.lemaDef}</span>
        <span class="lema-src">{copy.lemaSrc} <i lang="sa">krīḍā</i>: {copy.lemaSrcGloss}.</span>
      </p>
      <span class="footer-copy"
        >© {year} <a href={portfolioUrl} rel="noopener noreferrer">{copy.portfolio}</a> · <a
          href={`${root}/${copy.changelogPath}`}>{copy.changelog}</a
        > · <a href={`${root}/${copy.privacyPath}`}>{copy.privacy}</a></span
      >
    </footer>
  </main>
</Base>
