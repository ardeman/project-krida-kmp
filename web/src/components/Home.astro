    testShotClose: "Tutup",
    testStepOf: (n: number, total: number) => `Langkah ${n} dari ${total}`,
    testSteps: [
      {
        tab: "Google Group",
        title: "Gabung Google Group",
        body: "Masuk ke google-tester-indonesia dengan akun Google di HP-mu (sekali saja).",
        cta: "Gabung Google Group",
        href: "https://groups.google.com/g/google-tester-indonesia",
        img: "join/step-1-group.jpg",
        imgAlt: "Kartu TesBareng langkah 1: Gabung Google Group, salin email grup, dan tombol Gabung Google Group.",
      },
      {
        tab: "Buka Krida",
        title: "Masuk dengan Google, buka Krida",
        body: "Masuk TesBareng dengan Google, lalu buka halaman Krida di daftar app (tombol di bawah).",
        cta: "Buka Krida di TesBareng",
        href: "https://tesbareng.vercel.app/apps/b2bfd6e9-f394-46b9-adb8-277ba9583ca6",
        strong: true,
        img: "join/step-2-krida.jpg",
        imgAlt: "Kartu TesBareng langkah 2: Masuk dengan Google, lalu pilih app yang ingin diuji.",
      },
      {
        tab: "Jadi tester",
        title: "Gabung sebagai tester",
        body: "Di halaman Krida, ketuk “Gabung sebagai tester”, lalu “Buka link opt-in”. Cohort tidak wajib.",
        img: "join/step-3-gabung.jpg",
        imgAlt: "Tombol Gabung sebagai tester dan Buka link opt-in, plus tip tiga langkah di TesBareng.",
      },
      {
        tab: "Opt-in Play",
        title: "Opt-in di Play, lalu install",
        body: "Di Play, ketuk “Become a tester” / “Jadi tester”, install Krida, main sebentar, kirim feedback.",
        cta: "Buka opt-in Google Play",
        href: "https://play.google.com/apps/testing/com.ardeman.krida",
        strong: true,
        img: "join/step-4-play.jpg",
        imgAlt: "Halaman Google Play testing Krida dengan tombol Become a tester.",
      },
    ],
    games: [
      { name: "Congklak", players: "2 pemain", tagline: "Kumpulkan biji terbanyak di lumbungmu." },
      { name: "Ular tangga", players: "2–4 pemain", tagline: "Naiki tangga, hindari ular." },
      { name: "Ludo", players: "2–4 pemain", tagline: "Pacu empat bidakmu ke rumah." },
      { name: "Perang kapal", players: "2 pemain", tagline: "Tenggelamkan armadanya." },
      { name: "Gaple", players: "2–4 pemain", tagline: "Sambung ujungnya, habiskan kartumu." },
    ],
    whyTitle: "Kenapa Krida",
    features: [
      { title: "Main offline", body: "Lewat Bluetooth atau Wi‑Fi yang sama, tanpa internet. Cocok di rumah, di mobil, atau di warung." },
      { title: "Android ↔ iPhone", body: "Semua bisa satu meja, apa pun HP-nya, di setiap mode. Sampai 4 pemain." },
      { title: "Online juga bisa", body: "Bagikan kode room atau QR ke teman yang jauh, atau gabung room publik dan cari pemain lain." },
      { title: "Lawan komputer", body: "Main sendiri lawan komputer, atau gantian berdua di satu HP. Kursi kosong bisa diisi komputer." },
      { title: "Teman", body: "Akun opsional lewat Apple atau Google: tambah teman dengan kodenya dan undang mereka ke room." },
      { title: "Ringan", body: "Aplikasi native, ukuran kecil, lancar di tablet kelas menengah." },
    ],
    lemaDef: "Alasan untuk duduk satu meja, menjadi lawan selama satu ronde, lalu tertawa bersama sesudahnya.",
    lemaSrc: "Dari Sanskerta",
    lemaSrcGloss: "bermain",
    privacy: "Kebijakan privasi",
    privacyPath: "privasi/",
    changelog: "Catatan perubahan",
    changelogPath: "catatan/",
  },
  en: {
    title: "Krida — Board games from Indonesia, play together anywhere",
    description:
      "Congklak, snakes & ladders, ludo, battleship and gaple in 3D voxel style. Play the computer, offline over Bluetooth or Wi‑Fi, or online; Android and iPhone play together.",
    gamesNav: "Games",
    h1: "Play together, anywhere.",
    lead: "Congklak, snakes & ladders, ludo, battleship and gaple, remade as little toys you can play with family and friends. Against the computer, offline over Bluetooth or Wi‑Fi, or online.",
    soon: "Come join as a closed tester — how to join below.",
    testNav: "Closed tester",
    testTitle: "Come join as a closed tester",
    testLead:
      "Krida is on Google Play closed testing first. Join as a pure tester on TesBareng — you don’t need your own app.",
    testVideoCaption: "Closed testing invite",
    testVideoWatch: "Watch on YouTube",
    testHow: "How to join",
    testPrev: "Previous",
    testNext: "Next",
    testShot: "View screenshot",
    testShotClose: "Close",
    testStepOf: (n: number, total: number) => `Step ${n} of ${total}`,
    testSteps: [
      {
        tab: "Google Group",
        title: "Join the Google Group",
        body: "Join google-tester-indonesia with the Google account on your phone (once is enough).",
        cta: "Join the Google Group",
        href: "https://groups.google.com/g/google-tester-indonesia",
        img: "join/step-1-group.jpg",
        imgAlt: "TesBareng step 1 card: join Google Group, copy group email, Gabung Google Group button.",
      },
      {
        tab: "Open Krida",
        title: "Sign in with Google, open Krida",
        body: "Sign in to TesBareng with Google, then open Krida’s page in the app list (button below).",
        cta: "Open Krida on TesBareng",
        href: "https://tesbareng.vercel.app/apps/b2bfd6e9-f394-46b9-adb8-277ba9583ca6",
        strong: true,
        img: "join/step-2-krida.jpg",
        imgAlt: "TesBareng step 2 card: sign in with Google, then pick an app to test.",
      },
      {
        tab: "Join tester",
        title: "Join as a tester",
        body: "On Krida’s page, tap “Gabung sebagai tester”, then “Buka link opt-in”. A cohort is optional.",
        img: "join/step-3-gabung.jpg",
        imgAlt: "Gabung sebagai tester and Buka link opt-in buttons, plus TesBareng’s three-step tip.",
      },
      {
        tab: "Opt-in Play",
        title: "Opt in on Play, then install",
        body: "On Play, tap “Become a tester”, install Krida, play a bit, leave feedback.",
        cta: "Open Google Play opt-in",
        href: "https://play.google.com/apps/testing/com.ardeman.krida",
        strong: true,
        img: "join/step-4-play.jpg",
        imgAlt: "Google Play testing page for Krida with Become a tester.",
      },
    ],
    games: [
      { name: "Congklak", players: "2 players", tagline: "Gather the most seeds in your store." },
      { name: "Snakes & ladders", players: "2–4 players", tagline: "Climb the ladders, dodge the snakes." },
      { name: "Ludo", players: "2–4 players", tagline: "Race your four tokens home." },
      { name: "Battleship", players: "2 players", tagline: "Sink the fleet." },
      { name: "Gaple", players: "2–4 players", tagline: "Match the ends, empty your hand." },
    ],
    whyTitle: "Why Krida",
    features: [
      { title: "Play offline", body: "Over Bluetooth or the same Wi‑Fi, no internet needed. At home, in the car, or at a roadside café." },
      { title: "Android ↔ iPhone", body: "Everyone at one table, whatever their phone, in every mode. Up to 4 players." },
      { title: "Online too", body: "Share a room code or QR with a friend far away, or join a public room and find other players." },
      { title: "Against the computer", body: "Play solo against the computer, or take turns on one phone. Empty seats can go to the computer." },
      { title: "Friends", body: "An optional account with Apple or Google: add friends by their code and invite them to your room." },
      { title: "Lightweight", body: "A native app, small download, smooth on a mid-range tablet." },
    ],
    lemaDef: "A reason to sit at one table, be rivals for a round, and laugh together afterwards.",
    lemaSrc: "Indonesian, from Sanskrit",
    lemaSrcGloss: "play",
    privacy: "Privacy policy",
    privacyPath: "en/privacy/",
    changelog: "Changelog",
    changelogPath: "en/changelog/",
  },
}[lang];

const games = copy.games.map((g, i) => ({ ...g, color: colors[i] }));
const year = new Date().getFullYear();
const joinSteps = copy.testSteps;
const joinTotal = joinSteps.length;
const joinRadioName = `join-${lang}`;
// YouTube uploads from the launch promo (ID / EN).
const youtubeId = lang === "id" ? "I1J0heCExhE" : "zNrHe3mnXcw";
const youtubeWatch = `https://youtu.be/${youtubeId}`;
const youtubeEmbed = `https://www.youtube-nocookie.com/embed/${youtubeId}`;
---

<Base title={copy.title} description={copy.description} lang={lang} alternates={alternates}>
  <main>
    <header class="nav">
      <a class="logo" href={`${root}/${alternates[lang]}`}><Wordmark height={30} /></a>
      <span class="nav-links">
        <a class="pill" href="#games">{copy.gamesNav}</a>
        <a class="pill" href="#closed-test">{copy.testNav}</a>
        <LangSwitch lang={lang} alternates={alternates} />
      </span>
    </header>

    <section class="hero">
      <div class="hero-text">
        <h1>{copy.h1}</h1>
        <p class="lead">{copy.lead}</p>
        <p class="soon"><a href="#closed-test">{copy.soon}</a></p>
      </div>
      <div class="hero-art"><Board /></div>
    </section>

    <section id="closed-test" class="section">
      <div class="test-layout">
        <div class="test-main">
          <h2>{copy.testTitle}</h2>
          <p class="test-lead">{copy.testLead}</p>

          <div class="test-wizard">
            <h3 class="test-how">{copy.testHow}</h3>
            {
              joinSteps.map((_, i) => (
                <input
                  class="test-wizard-radio"
                  type="radio"
                  name={joinRadioName}
                  id={`${joinRadioName}-${i}`}
                  checked={i === 0}
                />
              ))
            }
            <div class="test-wizard-tabs" role="tablist" aria-label={copy.testHow}>
              {
                joinSteps.map((step, i) => (
                  <label
                    class="test-wizard-tab"
                    for={`${joinRadioName}-${i}`}
                    title={step.title}
                  >
                    <span class="test-wizard-tab-num">{i + 1}</span>
                    <span class="test-wizard-tab-label">{step.tab}</span>
                  </label>
                ))
              }
            </div>
            <div class="test-wizard-stage">
              {
                joinSteps.map((step, i) => (
                  <article class={`test-wizard-panel test-wizard-panel-${i}`} aria-labelledby={`${joinRadioName}-${i}-title`}>
                    <p class="test-wizard-count">{copy.testStepOf(i + 1, joinTotal)}</p>
                    <h4 class="test-wizard-title" id={`${joinRadioName}-${i}-title`}>{step.title}</h4>
                    <p class="test-wizard-body">{step.body}</p>
                    <p class="test-wizard-actions">
                      {step.cta && step.href ? (
                        <a
                          class:list={["pill", { "pill-strong": step.strong }]}
                          href={step.href}
                          rel="noopener noreferrer"
                          target="_blank"
                        >
                          {step.cta}
                        </a>
                      ) : null}
                      {step.img ? (
                        <label class="pill test-shot-open" for={`shot-toggle-${lang}-${i}`}>{copy.testShot}</label>
                      ) : null}
                    </p>
                  </article>
                ))
              }
            </div>
            <div class="test-wizard-nav">
              {
                joinSteps.map((_, i) => (
                  <div class={`test-wizard-nav-row test-wizard-nav-${i}`}>
                    {i > 0 ? (
                      <label class="pill test-wizard-nav-btn" for={`${joinRadioName}-${i - 1}`}>{copy.testPrev}</label>
                    ) : (
                      <span class="test-wizard-nav-spacer" />
                    )}
                    {i < joinTotal - 1 ? (
                      <label class="pill pill-strong test-wizard-nav-btn" for={`${joinRadioName}-${i + 1}`}>{copy.testNext}</label>
                    ) : (
                      <span class="test-wizard-nav-spacer" />
                    )}
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <aside class="test-media">
          <div class="promo-video">
            <iframe
              class="promo-frame"
              src={youtubeEmbed}
              title={copy.testTitle}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>
          </div>
          <p class="promo-watch">
            <span>{copy.testVideoCaption}</span>
            {" · "}
            <a href={youtubeWatch} rel="noopener noreferrer" target="_blank">{copy.testVideoWatch}</a>
          </p>
        </aside>
      </div>

      {
        joinSteps.map((step, i) =>
          step.img ? (
            <>
              <input
                class="shot-toggle"
                type="checkbox"
                id={`shot-toggle-${lang}-${i}`}
                aria-hidden="true"
                tabindex={-1}
              />
              <div class="shot-lightbox" role="dialog" aria-label={step.imgAlt}>
                <label class="shot-lightbox-backdrop" for={`shot-toggle-${lang}-${i}`} aria-label={copy.testShotClose}></label>
                <figure class="shot-lightbox-frame">
                  <label class="shot-lightbox-close pill" for={`shot-toggle-${lang}-${i}`}>{copy.testShotClose}</label>
                  <img src={`${root}/${step.img}`} alt={step.imgAlt} loading="lazy" width="1100" />
                </figure>
              </div>
            </>
          ) : null,
        )
      }
    </section>

    <section id="games" class="section">
      <h2>{copy.gamesNav}</h2>
      <div class="games">
        {
          games.map((g) => (
            <article class="game">
              <Voxel color={g.color} size={48} />
              <h3 lang={g.name === "Snakes & ladders" ? undefined : "id"}>{g.name}</h3>
              <p class="players">{g.players}</p>
              <p>{g.tagline}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <h2>{copy.whyTitle}</h2>
      <div class="features">
        {
          copy.features.map((f) => (
            <article class="feature">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <footer class="footer">
      <p class="lema">
        <span class="lema-head"><b lang="id">krida</b> <span class="lema-say">/kri·da/</span> <i>n.</i></span>
        <span class="lema-def">{copy.lemaDef}</span>
        <span class="lema-src">{copy.lemaSrc} <i lang="sa">krīḍā</i>: {copy.lemaSrcGloss}.</span>
      </p>
      <span class="footer-copy"
        >© {year} Krida · krida.ardeman.com · <a href={`${root}/${copy.changelogPath}`}>{copy.changelog}</a> · <a
          href={`${root}/${copy.privacyPath}`}>{copy.privacy}</a
        ></span
      >
    </footer>
  </main>
</Base>
