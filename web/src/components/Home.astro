      {
        title: "Masuk TesBareng, buka Krida",
        body: "Ketuk “Masuk dengan Google”, lalu buka halaman Krida di daftar app (atau lewat tombol di bawah).",
      },
      {
        title: "Gabung sebagai tester",
        body: "Ketuk “Gabung sebagai tester”. Cohort tidak wajib — tester murni boleh langsung ngetes Krida.",
      },
      {
        title: "Opt-in di Google Play, lalu install",
        body: "Buka tautan opt-in dari TesBareng, ketuk “Jadi tester”, install Krida dari jalur closed testing, main sebentar, dan kirim feedback di Play dengan kata-katamu sendiri.",
      },
    ],
    testFigures: [
      {
        src: "join/step-tesbareng.jpg",
        alt: "Tiga langkah gabung di halaman TesBareng: Google Group, masuk dengan Google, lalu pilih app.",
        caption: "Di TesBareng: Google Group → masuk → pilih app (cuplikan layar sungguhan).",
      },
      {
        src: "join/step-krida-list.jpg",
        alt: "Krida: Permainan Tradisional di daftar app TesBareng, status mencari tester.",
        caption: "Krida sudah ada di daftar app TesBareng — cari namanya, lalu buka halaman app-nya.",
      },
      {
        src: "join/step-optin.jpg",
        alt: "Titik cek TesBareng: opt-in dan install di hari 0, lalu pakai dan kirim feedback.",
        caption: "Sesudah gabung: buka link opt-in Play, install, main, lalu kirim feedback di Play.",
      },
    ],
    testCta: "Buka Krida di TesBareng",
    testHref: "https://tesbareng.vercel.app/apps/b2bfd6e9-f394-46b9-adb8-277ba9583ca6",
    testGroupCta: "Gabung Google Group",
    testGroupHref: "https://groups.google.com/g/google-tester-indonesia",
    testGuide: "Cara gabung (cuplikan layar TesBareng)",
    games: [
      { name: "Congklak", players: "2 pemain", tagline: "Kumpulkan biji terbanyak di lumbungmu." },
      { name: "Ular tangga", players: "2–4 pemain", tagline: "Naiki tangga, hindari ular." },
      { name: "Ludo", players: "2–4 pemain", tagline: "Pacu empat bidakmu ke rumah." },
      { name: "Perang kapal", players: "2 pemain", tagline: "Tenggelamkan armadanya." },
      { name: "Gaple", players: "2–4 pemain", tagline: "Sambung ujungnya, habiskan kartumu." },
    ],
    whyTitle: "Kenapa Krida",
    features: [
      { title: "Main offline", body: "Lewat Bluetooth atau Wi‑Fi yang sama, tanpa internet. Cocok di rumah, di mobil, atau di warung." },
      { title: "Android ↔ iPhone", body: "Semua bisa satu meja, apa pun HP-nya, di setiap mode. Sampai 4 pemain." },
      { title: "Online juga bisa", body: "Bagikan kode room atau QR ke teman yang jauh, atau gabung room publik dan cari pemain lain." },
      { title: "Lawan komputer", body: "Main sendiri lawan komputer, atau gantian berdua di satu HP. Kursi kosong bisa diisi komputer." },
      { title: "Teman", body: "Akun opsional lewat Apple atau Google: tambah teman dengan kodenya dan undang mereka ke room." },
      { title: "Ringan", body: "Aplikasi native, ukuran kecil, lancar di tablet kelas menengah." },
    ],
    lemaDef: "Alasan untuk duduk satu meja, menjadi lawan selama satu ronde, lalu tertawa bersama sesudahnya.",
    lemaSrc: "Dari Sanskerta",
    lemaSrcGloss: "bermain",
    privacy: "Kebijakan privasi",
    privacyPath: "privasi/",
  },
  en: {
    title: "Krida — Board games from Indonesia, play together anywhere",
    description:
      "Congklak, snakes & ladders, ludo, perang kapal and gaple in 3D voxel style. Play the computer, offline over Bluetooth or Wi‑Fi, or online; Android and iPhone play together.",
    gamesNav: "Games",
    promoNav: "Trailer",
    h1: "Play together, anywhere.",
    lead: "Congklak, snakes & ladders, ludo, perang kapal and gaple, remade as little toys you can play with family and friends. Against the computer, offline over Bluetooth or Wi‑Fi, or online.",
    soon: "Come join as a closed tester — how to join below.",
    promoTitle: "Krida trailer",
    promoLead: "See congklak, snakes & ladders, ludo, perang kapal and gaple in voxel style — and how you play together anywhere.",
    promoWatch: "Watch on YouTube",
    testNav: "Closed tester",
    testTitle: "Come join as a closed tester",
    testLead:
      "Krida is on Google Play closed testing first. You don’t need your own app: join as a pure tester on TesBareng, then opt in on Play.",
    testSteps: [
      {
        title: "Join the Google Group",
        body: "Join google-tester-indonesia with the Google account on your phone. Once is enough for every app in the community.",
      },
      {
        title: "Sign in to TesBareng, open Krida",
        body: "Tap “Sign in with Google”, then open Krida’s page in the app list (or use the button below).",
      },
      {
        title: "Join as a tester",
        body: "Tap “Gabung sebagai tester”. A cohort is optional — pure testers can help with Krida right away.",
      },
      {
        title: "Opt in on Google Play, then install",
        body: "Open the Play opt-in link from TesBareng, tap “Become a tester”, install Krida from the closed track, play a bit, and leave Play feedback in your own words if you like.",
      },
    ],
    testFigures: [
      {
        src: "join/step-tesbareng.jpg",
        alt: "TesBareng’s three join steps: Google Group, sign in with Google, then pick an app.",
        caption: "On TesBareng: Google Group → sign in → pick an app (real screenshot).",
      },
      {
        src: "join/step-krida-list.jpg",
        alt: "Krida: Permainan Tradisional in the TesBareng app list, searching for testers.",
        caption: "Krida is listed on TesBareng — find the name, then open its app page.",
      },
      {
        src: "join/step-optin.jpg",
        alt: "TesBareng checkpoints: opt in and install on day 0, then play and send feedback.",
        caption: "After joining: open the Play opt-in link, install, play, then send Play feedback.",
      },
    ],
    testCta: "Open Krida on TesBareng",
    testHref: "https://tesbareng.vercel.app/apps/b2bfd6e9-f394-46b9-adb8-277ba9583ca6",
    testGroupCta: "Join the Google Group",
    testGroupHref: "https://groups.google.com/g/google-tester-indonesia",
    testGuide: "How to join (TesBareng screenshots)",
    games: [
      { name: "Congklak", players: "2 players", tagline: "Gather the most seeds in your store." },
      { name: "Snakes & ladders", players: "2–4 players", tagline: "Climb the ladders, dodge the snakes." },
      { name: "Ludo", players: "2–4 players", tagline: "Race your four tokens home." },
      { name: "Perang kapal", players: "2 players", tagline: "Sink the fleet." },
      { name: "Gaple", players: "2–4 players", tagline: "Match the ends, empty your hand." },
    ],
    whyTitle: "Why Krida",
    features: [
      { title: "Play offline", body: "Over Bluetooth or the same Wi‑Fi, no internet needed. At home, in the car, or at a roadside café." },
      { title: "Android ↔ iPhone", body: "Everyone at one table, whatever their phone, in every mode. Up to 4 players." },
      { title: "Online too", body: "Share a room code or QR with a friend far away, or join a public room and find other players." },
      { title: "Against the computer", body: "Play solo against the computer, or take turns on one phone. Empty seats can go to the computer." },
      { title: "Friends", body: "An optional account with Apple or Google: add friends by their code and invite them to your room." },
      { title: "Lightweight", body: "A native app, small download, smooth on a mid-range tablet." },
    ],
    lemaDef: "A reason to sit at one table, be rivals for a round, and laugh together afterwards.",
    lemaSrc: "Indonesian, from Sanskrit",
    lemaSrcGloss: "play",
    privacy: "Privacy policy",
    privacyPath: "en/privacy/",
  },
}[lang];

const games = copy.games.map((g, i) => ({ ...g, color: colors[i] }));
const year = new Date().getFullYear();
// YouTube uploads from the launch promo (ID / EN).
const youtubeId = lang === "id" ? "I1J0heCExhE" : "zNrHe3mnXcw";
const youtubeWatch = `https://youtu.be/${youtubeId}`;
const youtubeEmbed = `https://www.youtube-nocookie.com/embed/${youtubeId}`;
---

<Base title={copy.title} description={copy.description} lang={lang} alternates={alternates}>
  <main>
    <header class="nav">
      <a class="logo" href={`${root}/${alternates[lang]}`}><Wordmark height={30} /></a>
      <span class="nav-links">
        <a class="pill" href="#games">{copy.gamesNav}</a>
        <a class="pill" href="#promo">{copy.promoNav}</a>
        <a class="pill" href="#closed-test">{copy.testNav}</a>
        <LangSwitch lang={lang} alternates={alternates} />
      </span>
    </header>

    <section class="hero">
      <div class="hero-text">
        <h1>{copy.h1}</h1>
        <p class="lead">{copy.lead}</p>
        <p class="soon"><a href="#closed-test">{copy.soon}</a></p>
      </div>
      <div class="hero-art"><Board /></div>
    </section>

    <section id="games" class="section">
      <h2>{copy.gamesNav}</h2>
      <div class="games">
        {
          games.map((g) => (
            <article class="game">
              <Voxel color={g.color} size={48} />
              <h3 lang={g.name === "Snakes & ladders" ? undefined : "id"}>{g.name}</h3>
              <p class="players">{g.players}</p>
              <p>{g.tagline}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="promo" class="section">
      <h2>{copy.promoTitle}</h2>
      <p class="test-lead">{copy.promoLead}</p>
      <div class="promo-video">
        <iframe
          class="promo-frame"
          src={youtubeEmbed}
          title={copy.promoTitle}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
      <p class="promo-watch">
        <a href={youtubeWatch} rel="noopener noreferrer" target="_blank">{copy.promoWatch}</a>
      </p>
    </section>

    <section id="closed-test" class="section">
      <h2>{copy.testTitle}</h2>
      <p class="test-lead">{copy.testLead}</p>
      <ol class="test-steps">
        {
          copy.testSteps.map((step) => (
            <li>
              <strong>{step.title}</strong>
              <span>{step.body}</span>
            </li>
          ))
        }
      </ol>
      <p class="test-actions">
        <a class="pill pill-strong" href={copy.testHref} rel="noopener noreferrer" target="_blank">{copy.testCta}</a>
        <a class="pill" href={copy.testGroupHref} rel="noopener noreferrer" target="_blank">{copy.testGroupCta}</a>
      </p>
      <h3 class="test-guide">{copy.testGuide}</h3>
      <div class="test-figures">
        {
          copy.testFigures.map((fig) => (
            <figure class="test-figure">
              <a href={`${root}/${fig.src}`} target="_blank" rel="noopener noreferrer">
                <img src={`${root}/${fig.src}`} alt={fig.alt} loading="lazy" width="1100" />
              </a>
              <figcaption>{fig.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="section">
      <h2>{copy.whyTitle}</h2>
      <div class="features">
        {
          copy.features.map((f) => (
            <article class="feature">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <footer class="footer">
      <p class="lema">
        <span class="lema-head"><b lang="id">krida</b> <span class="lema-say">/kri·da/</span> <i>n.</i></span>
        <span class="lema-def">{copy.lemaDef}</span>
        <span class="lema-src">{copy.lemaSrc} <i lang="sa">krīḍā</i>: {copy.lemaSrcGloss}.</span>
      </p>
      <span class="footer-copy">© {year} Krida · krida.ardeman.com · <a href={`${root}/${copy.privacyPath}`}>{copy.privacy}</a></span>
    </footer>
  </main>
</Base>
