---
/** Isometric voxel cube: one color, three shaded faces. Pure SVG, no JS. */
interface Props {
  color: string;
  size?: number;
}
const { color, size = 64 } = Astro.props;
---

<svg class="voxel" width={size} height={size} viewBox="0 0 100 100" aria-hidden="true">
  <polygon points="50,4 94,29 50,54 6,29" fill={color}></polygon>
  <polygon points="50,4 94,29 50,54 6,29" fill="#fff" opacity="0.18"></polygon>
  <polygon points="6,29 50,54 50,98 6,73" fill={color}></polygon>
  <polygon points="6,29 50,54 50,98 6,73" fill="#000" opacity="0.1"></polygon>
  <polygon points="94,29 50,54 50,98 94,73" fill={color}></polygon>
  <polygon points="94,29 50,54 50,98 94,73" fill="#000" opacity="0.28"></polygon>
</svg>
