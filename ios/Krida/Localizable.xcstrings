            "value": "Next round"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ronde berikutnya"
          }
        }
      }
    },
    "Waiting for the host": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the host"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu tuan rumah"
          }
        }
      }
    },
    "First to 100 points": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First to 100 points"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertama ke 100 poin"
          }
        }
      }
    },
    "Team %@ wins": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Team %@ wins"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tim %@ menang"
          }
        }
      }
    },
    "Your team wins!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your team wins!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timmu menang!"
          }
        }
      }
    },
    "You play %1$lld|%2$lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You play %1$lld|%2$lld"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu main %1$lld|%2$lld"
          }
        }
      }
    },
    "A double-six set of 28 tiles. Everyone gets 7; with 2 or 3 players the rest stay face down.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A double-six set of 28 tiles. Everyone gets 7; with 2 or 3 players the rest stay face down."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu set balak enam, 28 kartu. Tiap pemain dapat 7; dengan 2 atau 3 pemain sisanya tetap tertutup."
          }
        }
      }
    },
    "The first round opens with balak enam [6|6], or the highest double if nobody holds it. Later rounds: the last winner leads with any tile.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first round opens with balak enam [6|6], or the highest double if nobody holds it. Later rounds: the last winner leads with any tile."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ronde pertama dibuka dengan balak enam [6|6], atau balak tertinggi kalau tak ada yang memegangnya. Ronde berikutnya: pemenang terakhir membuka dengan kartu apa saja."
          }
        }
      }
    },
    "A tile must match an open end. Tap one that fits only one end to play it; if it fits both, the matching ends light up — tap the one you want.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tile must match an open end. Tap one that fits only one end to play it; if it fits both, the matching ends light up — tap the one you want."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu harus cocok dengan ujung yang terbuka. Ketuk kartu yang hanya cocok di satu ujung untuk memainkannya; kalau cocok di dua ujung, ujung yang cocok menyala — ketuk yang kamu mau."
          }
        }
      }
    },
    "No tile fits? You pass. There is no drawing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tile fits? You pass. There is no drawing."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak ada kartu yang cocok? Kamu pas. Tidak ada ambil kartu."
          }
        }
      }
    },
    "The round ends when someone empties their hand (domino) or nobody can play (gaple): then the lowest pips in hand wins.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The round ends when someone empties their hand (domino) or nobody can play (gaple): then the lowest pips in hand wins."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ronde selesai kalau ada yang kartunya habis (domino) atau tak ada yang bisa jalan (gaple): mata terkecil di tangan menang."
          }
        }
      }
    },
    "The round winner scores the pips left in the other hands. First to 100 wins.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The round winner scores the pips left in the other hands. First to 100 wins."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemenang ronde dapat poin dari sisa mata di tangan lawan. Pertama ke 100 menang."
          }
        }
      }
    },
    "Partners: seats across play as a team and share one score.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partners: seats across play as a team and share one score."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berpasangan: kursi yang berhadapan satu tim dan berbagi satu skor."
          }
        }
      }
    },
    "15 seconds a turn: when time runs out the phone plays your heaviest fitting tile.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "15 seconds a turn: when time runs out the phone plays your heaviest fitting tile."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "15 detik tiap giliran: kalau waktu habis, ponsel memainkan kartumu yang cocok dan paling berat."
          }
        }
      }
    },
    "Up to 4 phones over Bluetooth, each hand on its own phone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 4 phones over Bluetooth, each hand on its own phone"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingga 4 HP lewat Bluetooth, kartu di HP masing-masing"
          }
        }
      }
    },
    "Up to 4 phones over the internet, each hand on its own phone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 4 phones over the internet, each hand on its own phone"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingga 4 HP lewat internet, kartu di HP masing-masing"
          }
        }
      }
    },
    "Tower blocks": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tower blocks"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menara menghalangi"
          }
        }
      }
    },
    "Tower blocks: opponents cannot pass a tower of two or more tokens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tower blocks: opponents cannot pass a tower of two or more tokens."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menara menghalangi: lawan tidak bisa melewati menara dua bidak atau lebih."
          }
        }
      }
    },
    "Tower blocks off: opponents may jump over a tower.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tower blocks off: opponents may jump over a tower."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menara menghalangi mati: lawan boleh melompati menara."
          }
        }
      }
    },
    "Opponents cannot pass a tower; your own tokens can.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opponents cannot pass a tower; your own tokens can."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawan tidak bisa melewati menara; bidakmu sendiri boleh."
          }
        }
      }
    },
    "Drawing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawing"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil kartu"
          }
        }
      }
    },
    "Until it fits": {
      "localizations": {
