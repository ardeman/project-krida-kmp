        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk aturan untuk menyalakan atau mematikannya; penjelasannya muncul di sini."
          }
        }
      }
    },
    "6 lempar lagi: dapat 6, lempar dadu sekali lagi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 rolls again: roll a 6 and you roll once more."
