{
  "sourceLanguage" : "en",
  "strings" : {
    "Tembak (ambil biji di lubang lawan) hanya berlaku setelah bijimu melewati lumbungmu di giliran itu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A capture (tembak) only counts once your seeds have passed your own store this turn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tembak (ambil biji di lubang lawan) hanya berlaku setelah bijimu melewati lumbungmu di giliran itu."
          }
        }
      }
    },
    "Tembak kapan saja: biji terakhir di lubang kosongmu mengambil biji di lubang lawan di depannya." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture anytime: your last seed in an empty hole on your side takes the seeds in the hole opposite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tembak kapan saja: biji terakhir di lubang kosongmu mengambil biji di lubang lawan di depannya."
          }
        }
      }
    },
    "Ketuk aturan untuk menyalakan atau mematikannya; penjelasannya muncul di sini." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a rule to turn it on or off; it is explained here."
